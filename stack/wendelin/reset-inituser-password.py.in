#!{{ python_executable }}
import sys
import os
import binascii
import transaction
import Zope2

from Zope2.Startup.run import make_wsgi_app
from AccessControl.users import system
from AccessControl.SecurityManagement import newSecurityManager
from Acquisition import aq_base
from OFS.userfolder import UserFolder

inituser_login = {{ inituser_login }}

if len(sys.argv) != 2:
  sys.exit('Usage: %s <zope.conf>' % sys.argv[0])

make_wsgi_app({}, sys.argv[1])
app = Zope2.app()
newSecurityManager(None, system)

if not isinstance(aq_base(app.acl_users), UserFolder):
  raise RuntimeError('acl_users should be an UserFolder')

user = app.acl_users.getUserById(inituser_login)
if user is None:
  raise RuntimeError("User %r is not found" % inituser_login)

password = binascii.hexlify(os.urandom(32))
if not isinstance(password, str):
  password = password.decode('ascii')

transaction.begin()
try:
  app.acl_users._doChangeUser(
    inituser_login,
    password,
    list(user.getRoles()),
    list(user.getDomains())
  )
  transaction.commit()
except:
  transaction.abort()
  raise

print("Successfully replaced the %r user's password." % inituser_login)
