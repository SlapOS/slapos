#!/bin/bash
#
# Create a backup of the disk image of the virtual machine
#
set -e
LC_ALL=C
export LC_ALL
BACKUP_DIR={{ directory['backup'] }}
CHAIN_DIR={{ backup_chain_directory }}

log=$(mktemp --tmpdir={{ directory['tmp'] }})
trap "rm -f $log" EXIT TERM INT

set +e
qmpbackup="{{ qmpbackup }} --socket {{ qmp_socket_path }}"
# any chain directory but the current one comes from a qmpbackup which named it
# differently (device name before 0.47, qemu node name before 0.63), and its
# bitmaps are unusable for the current one
if [ x"$(find $BACKUP_DIR -mindepth 1 -maxdepth 1 -type d \! -name $(basename $CHAIN_DIR))" != x"" ] ; then
  rm -fr $BACKUP_DIR/*
  $qmpbackup cleanup --remove-bitmap
  echo "Migrated from old style backup by removing backup directory and bitmaps"
fi
# the old style backup was a plain file, which since qmpbackup 0.63 has exactly
# the name of the backup chain directory, so it has to go before the backup runs
find $BACKUP_DIR -maxdepth 1 -type f \
  \( -name $(basename $CHAIN_DIR) -o -name $(basename $CHAIN_DIR).gz \) -delete
qmpbackup_backup="$qmpbackup backup --compress --target $BACKUP_DIR --include {{ disk['device'] }}"

# qmpbackup --level auto only ever appends increments, and a guest which
# rewrites its disk makes them sum up to more than the image itself, so restart
# the chain with a full backup once it grew too big
level=auto
{%- if rolling_full_permille | int > 0 %}
full_time=$(find $CHAIN_DIR -maxdepth 1 -type f -name 'FULL-*.qcow2' -printf '%T@\n' 2> /dev/null | cut -d. -f 1 | sort -n | tail -n 1)
if [ x"$full_time" != x"" ] ; then
  chain_size=$(du -s --block-size=1 $CHAIN_DIR | cut -f 1)
  # empty for a disk image which is not a file, and then the chain is compared
  # with nothing, so keep appending increments
  image_size=$(du -s --block-size=1 {{ disk_path }} | cut -f 1)
  if [ x"$image_size" != x"" ] \
    && [ $(($chain_size * 1000)) -gt $(($image_size * {{ rolling_full_permille | int }})) ] ; then
    # a full backup is transferred to the pull backup server in whole and kept
    # there as an increment, so do not roll more often than it keeps them
    if [ $(($(date +%s) - $full_time)) -ge {{ rolling_full_interval | int }} ] ; then
      level=full
      # the new full backup has to fit next to the disk image, which the chain
      # is already bigger than, so make room for it before it is written, also
      # for the partial files of previously failed backups
      find $CHAIN_DIR -type f -delete
      echo "Rolling full backup, as backup chain of $chain_size bytes exceeded" \
        "{{ rolling_full_permille | int / 1000 }} times the disk image of $image_size bytes"
    else
      echo "Keeping incremental backup, as backup chain of $chain_size bytes" \
        "exceeded {{ rolling_full_permille | int / 1000 }} times the disk image" \
        "of $image_size bytes, but the full backup is younger than" \
        "{{ rolling_full_interval | int }} seconds"
    fi
  fi
fi
{%- endif %}
$qmpbackup_backup --level $level &> $log
RESULT=$?
cat $log
if [ $RESULT -ne 0 ] ; then
  # recover from unfinished previous backup
  if egrep -q 'Partial backup found in.*possible broken backup chain. Execute new full backup' $log ; then
    find $CHAIN_DIR -name '*.partial' -delete
    $qmpbackup_backup --level auto || exit $?
    echo "Recovered from partial backup by removing partial"
  elif egrep -q 'Incremental backup requested but no active bitmap has been found' $log ; then
    find $CHAIN_DIR -name '*.qcow2' -delete
    $qmpbackup_backup --level full || exit $?
    echo "Post take-over or post qmpbackup upgrade cleanup"
  elif egrep -q 'No full backup found for device.*in.*: Execute full backup first.' $log ; then
    $qmpbackup_backup --level full || exit $?
    echo "Recovered from empty backup"
  elif egrep -q 'Bitmap for device .* is not in state ready for backup.' $log ; then
    # please note that it was not possible to reproduce this situation in unit tests
    $qmpbackup cleanup --remove-bitmap
    $qmpbackup_backup --level full || exit $?
    echo "Recovered from state not ready"
  else
    echo "Unknown situation"
    exit $RESULT
  fi
fi
set -e

# cleanup the backup directory from too old backups, especially important after take-over
recent_full=$(find $BACKUP_DIR -type f -name 'FULL-*.qcow2' -exec ls -t1 {} + | head -n1)
if [ x"$recent_full" != x"" ] ; then
  for f in $(find $BACKUP_DIR -type f -name '*qcow2' \! -newer $recent_full) ; do
    if [ "$f" != "$recent_full" ] ; then
      rm -vf $f
    fi
  done
fi

{{ backup_signature }} --action update --directory $BACKUP_DIR --signature-file-name backup.signature
