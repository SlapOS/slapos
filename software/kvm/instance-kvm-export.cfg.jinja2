[buildout]
extends =
  {{ kvm_template }}
  {{ pbsready_export_template }}

parts +=
  cron-entry-backup
  ${instance-kvm-parts:parts}
  check-backup-directory-promise

[slap-parameter]
{% for k, v in slapparameter_dict.items() -%}
{%-  if k == 'namebase' %}
{{ k }} = {{ v }}
{%-  else %}
{{ k }} = {{ dumps(v) }}
{%-  endif %}
{% endfor -%}

[directory]
tmp = ${buildout:directory}/tmp

[disk]
{%- set disk_type = slapparameter_dict.get('disk-type', 'virtio') %}
{%- if disk_type == "virtio" %}
device = virtio0
{%- elif disk_type == "ide" %}
{#-   Manually found device name in case of disk-type == ide #}
device = ide0-hd0
{%- else %}
# unsupported disk-type {{ disk_type }}
{%- endif %}

# qmpbackup >= 0.63 stores the backup chain in a directory named after the
# disk image file, previous versions used the qemu node name (virtual1)
[backup-chain]
directory = ${directory:backup}/virtual.${slap-parameter:disk-format}

{#- the exporter compares with integer arithmetic only, so scale the ratio #}
{%- set rolling_full_permille = (slapparameter_dict.get('backup-rolling-full-ratio', 1.5) | float * 1000) | round | int %}
{#- rdiff-backup interval of the pull backup server, which can also be
    expressed as an amount of backups, like 3B, and then says nothing about
    the time an increment is kept #}
{%- set retention = slapparameter_dict.get('remove-backup-older-than', '2W') | string %}
{%- set retention_multiplier_dict = {'s': 1, 'm': 60, 'h': 3600, 'D': 86400, 'W': 604800, 'M': 2592000, 'Y': 31536000} %}
{%- set rolling_full_interval = (retention[:-1] | int(0)) * retention_multiplier_dict.get(retention[-1:], 0) or 2 * 604800 %}

[backup-info]
file = ${directory:var}/backup-in-progress

[exporter]
recipe = slapos.cookbook:wrapper
wrapper-path = ${directory:bin}/${slap-parameter:namebase}-exporter
command-line = {{ flock }} --nonblock --no-fork ${backup-info:file} ${exporter-real:output}

# Resilient stack wants a "wrapper" parameter
wrapper = ${:wrapper-path}

[exporter-real]
recipe = slapos.recipe.template:jinja2
url = {{ template_kvm_export }}
output = ${directory:bin}/${slap-parameter:namebase}-exporter-real
context =
    section directory directory
    section buildout buildout
    key qmp_socket_path kvm-parameter-dict:qmp-socket-path
    key backup_info backup-info:file
    key backup_chain_directory backup-chain:directory
    key disk_path kvm-parameter-dict:disk-path
    section disk disk
    raw qmpbackup {{ qmpbackup }}
    raw backup_signature {{ backup_signature }}
    raw rolling_full_permille {{ rolling_full_permille }}
    raw rolling_full_interval {{ rolling_full_interval }}

# Extends publish section with resilient parameters
[publish-connection-information]
<= resilient-publish-connection-parameter
monitor-base-url = ${monitor-publish:monitor-base-url}
monitor-setup-url = ${monitor-publish:monitor-setup-url}

[monitor-instance-parameter]
monitor-httpd-port = 8026
monitor-title = {{ slapparameter_dict.get('name', 'KVM Standalone') }}
{% if slapparameter_dict.get('monitor-username', '') -%}
username = {{ slapparameter_dict['monitor-username'] }}
{% endif -%}
{% if slapparameter_dict.get('monitor-password', '') -%}
password = {{ slapparameter_dict['monitor-password'] }}
{% endif -%}

[check-backup-directory]
recipe = slapos.cookbook:wrapper
wrapper-path = ${directory:bin}/check-backup-directory
command-line = {{ flock }} --conflict-exit-code 0 --nonblock --no-fork ${backup-info:file} {{ check_backup_directory }} ${backup-chain:directory} ${directory:tmp} ${backup-info:file}

[check-backup-directory-promise]
# Check that disk image is not corrupted
<= monitor-promise-base
promise = check_command_execute
name = check-backup-directory.py
config-command = ${check-backup-directory:wrapper-path}
failure_amount = 5
