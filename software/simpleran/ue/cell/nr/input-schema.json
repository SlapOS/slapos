{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NR Cell",
  "type": "object",
  "required": [
    "cell_type",
    "cell_kind",
    "rf_mode",
    "ru",
    "dl_nr_arfcn",
    "bandwidth",
    "nr_band",
    "rx_to_tx_latency"
  ],
  "properties": {
    "cell_type": {
      "$ref": "../../../ue/cell/common.json#/properties/cell_type",
      "const": "nr"
    },
    "cell_kind": {
      "$ref": "../../../ue/cell/common.json#/properties/cell_kind"
    },
    "rf_mode": {
      "$ref": "../../../ue/cell/common.json#/properties/rf_mode"
    },
    "ru": {
      "$ref": "../../../ue/cell/common.json#/properties/ru",
      "propertyOrder": 9999
    },
    "dl_nr_arfcn": {
      "$ref": "../../../cell/nr/input-schema.json#/properties/dl_nr_arfcn"
    },
    "bandwidth": {
      "$ref": "../../../cell/common.json#/$defs/bandwidth"
    },
    "nr_band": {
      "$ref": "../../../cell/nr/input-schema.json#/properties/nr_band"
    },
    "ul_nr_arfcn": {
      "$ref": "../../../cell/nr/input-schema.json#/properties/ul_nr_arfcn"
    },
    "ssb_nr_arfcn": {
      "$ref": "../../../cell/nr/input-schema.json#/properties/ssb_nr_arfcn"
    },
    "rx_to_tx_latency": {
      "title": "RX to TX Latency",
      "description": "Range 2 to 32. Minimum allowed latency in slots between RX and TX. This parameter will bound the minimum k1 and k2 parameter allowed by the system. Increasing the value will improve performance, especially in case of radio frontend underflows.",
      "type": "integer"
    }
  }
}
