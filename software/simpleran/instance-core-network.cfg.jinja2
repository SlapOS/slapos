{%- macro amarisoft_service(name, template)  %}

[as-{{ name }}-rotate-sh-wrapper]
recipe = slapos.recipe.template
output = ${directory:bin}/${:_buildout_section_name_}
{{ name }}-log = ${directory:log}/{{ name }}.log
info-log = ${directory:log}/{{ name }}-info.log
start-date = ${directory:run}/{{ name }}-start.date
max-combined-{{ name }}-log-kb-size = 2000000
max-combined-info-log-kb-size  = 1000000
max-info-log-kb-size           = 100000
max-log-file-number            = 1000
inline =
  #!/bin/sh
  /bin/sh {{ amarisoft_log_rotate_sh }} \
            ${:start-date} \
            ${:{{ name }}-log} \
            ${:info-log} \
            ${:max-combined-{{ name }}-log-kb-size} \
            ${:max-combined-info-log-kb-size} \
            ${:max-info-log-kb-size}
            ${:max-log-file-number}

[as-{{ name }}-rotate-service]
recipe = slapos.cookbook:wrapper
command-line = ${as-{{ name }}-rotate-sh-wrapper:output}
wrapper-path = ${directory:service}/{{ name }}-rotate
mode = 0775
pidfile = ${directory:run}/{{ name }}.pid
hash-files =
  ${as-{{ name }}-rotate-sh-wrapper:output}

[as-{{ name }}-sh-wrapper]
recipe = slapos.recipe.template
output = ${directory:bin}/${:_buildout_section_name_}
{{ name }}-log = ${directory:log}/{{ name }}.log
info-log = ${directory:log}/{{ name }}-info.log
start-date = ${directory:run}/{{ name }}-start.date
inline =
  #!/bin/sh
{%- if not amarisoft['mock'] %}
  # Amarisoft init scripts
  sudo -n {{ amarisoft['script_dir'] }}/init-mme;
{%- endif %}
  # Print hardware and software info in info-log
  cat >> ${:info-log} << EOF



  $(date "+[%Y/%m/%d %T.%N %Z] Starting {{ name }}...")
  System info: $(uname -a)
  
  EOF
  # Remove obsolete logs
  rm -f ${directory:log}/{{ name }}-output*
  # Archive current log
  stat ${:start-date} && mv ${:{{ name }}-log} ${:{{ name }}-log}.$(cat ${:start-date})
  # Add start date
  date +"%Y%m%d.%T" > ${:start-date}

  # Start lte{{ name }}
  {{ amarisoft[name + '_dir'] }}/lte{{ name }} ${directory:etc}/{{ name }}.cfg 2>&1 >> ${:info-log}

[as-{{ name }}-service]
recipe = slapos.recipe.build
egg-paths =
  {{ eggs_directory }}
  {{ develop_eggs_directory }}
eggs = websockets
depends = ${as-{{ name }}-wrapper:recipe}
# amarisoft-wrapper.py script parameters
template-publish = ${directory:home}/template-publish-{{ name }}.cfg
amarisoft-service = lte{{ name }}
service-name = Core Network
ws-url = ws://{{ slapparameter_dict[name + '_com_url'] }}
ws-password = ${ws-{{ name }}-websocket-password:passwd}
mock = {{ amarisoft['mock'] }}
rm-tmp-lte = sudo -n {{ amarisoft['script_dir'] }}/rm-tmp-lte {{ name }}
{%- if slapparameter_dict.get('error') %}
error = {{ slapparameter_dict.get('error') }}
{%- endif %}
script-path = {{ amarisoft_wrapper }}
amarisoft-config-file = ${as-{{ name }}-config:output}
amarisoft-directory = {{ amarisoft[name + '_dir'] }}
amarisoft-license-dir = {{ amarisoft['license_dir'] }}
running-config-directory = ${directory:etc}
bin-directory = ${directory:bin}
service-directory = ${directory:service}
hash-output-file = ${directory:var}/{{ name }}-service-hash

init =
  options['location'] = ''
  import zc.buildout
  import pkg_resources
  zc.buildout.easy_install.install(
    [e.strip() for e in options['eggs'].splitlines()],
    dest=None,
    working_set=pkg_resources.working_set,
    path=[p.strip() for p in options['egg-paths'].splitlines()]
  )
update =
  with open(options['script-path'], 'r') as f:
    exec(f.read())

[as-{{ name }}-wrapper]
recipe = slapos.cookbook:wrapper
command-line = ${as-{{ name }}-sh-wrapper:output}
wrapper-path = ${directory:bin}/lte{{ name }}-service
mode = 0775
pidfile = ${directory:run}/{{ name }}.pid
hash-files =
  ${as-{{ name }}-sh-wrapper:output}
environment =
  AMARISOFT_PATH={{ amarisoft['license_dir'] }}

