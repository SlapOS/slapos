[buildout]
extends =
  ${monitor2-template:output}
eggs-directory = ${buildout:eggs-directory}
develop-eggs-directory = ${buildout:develop-eggs-directory}
parts =
  publish
  slapproxy_promise
  monitor_app_promise
  haproxy_promise
{%- if software_type == 'henri' %}
  henri_promise
{%- endif %}


[publish]
<= monitor-publish
recipe = slapos.cookbook:publish
slapproxy-ipv4-url = $${slapproxy:url}
{%- if software_type == 'henri' %}
slapproxy-ipv6-url = $${haproxy:henri-url}
{%- else %}
slapproxy-ipv6-url = $${haproxy:slapproxy-url}
{%- endif %}
monitor.app-url = $${haproxy:monitor.app-url}


[directory]
recipe = slapos.recipe.build:mkdirectory
etc = $${buildout:directory}/etc
service = $${:etc}/service
var = $${buildout:directory}/var
run = $${:var}/run
log = $${:var}/log
srv = $${buildout:directory}/srv
ssl = $${:srv}/ssl


[macro.promise]
<= monitor-promise-base
name = $${:_buildout_section_name_}.py


[json-schema-repository]
recipe = slapos.recipe.build:gitclone
repository = {{ slapparameter_dict['json-schema-repository']['url'] }}
revision = {{ slapparameter_dict['json-schema-repository']['revision'] }}
git-executable = ${git:location}/bin/git


[slapproxy.cfg]
recipe = slapos.recipe.template:jinja2
output = $${directory:etc}/$${:_buildout_section_name_}
inline =
  [slapproxy]
  computer_id = {{ slap_connection['computer-id'] }}
  host = $${:ipv4}
  port = $${:port}
  database_uri = $${directory:etc}/slapproxy.db
  public_directory_path = $${json-schema-repository:location}
ipv4 = {{ private_ipv4 }}
port = 4000


[slapproxy]
recipe = slapos.cookbook:wrapper
wrapper-path = $${directory:service}/$${:_buildout_section_name_}
command-line =
  ${slapos-command:bin-directory}/slapos proxy start
    --cfg $${slapproxy.cfg:output}
hash-files =
  $${slapproxy.cfg:output}
ipv4 = $${slapproxy.cfg:ipv4}
port = $${slapproxy.cfg:port}
url = http://$${:ipv4}:$${:port}


[slapproxy_promise]
<= macro.promise
promise = check_url_available
config-url = $${slapproxy:url}

{% if software_type == 'henri' %}
[henri]
recipe = slapos.cookbook:wrapper
wrapper-path = $${directory:service}/$${:_buildout_section_name_}
command-line =
  sh -c 'cd $${buildout:directory} && exec ${buildout:bin-directory}/ors-henri-gui'
environment =
  HENRI_HOST=$${:ipv4}
  HENRI_PORT=$${:port}
ipv4 = $${slapproxy.cfg:ipv4}
port = 4002
url = http://$${:ipv4}:$${:port}/henri/


[henri_promise]
<= macro.promise
promise = check_url_available
config-url = $${henri:url}

{% endif %}
[monitor.app]
recipe = slapos.cookbook:simplehttpserver
wrapper = $${directory:service}/$${:_buildout_section_name_}
base-path = ${monitor.app:location}
log-file = $${directory:log}/monitor.app.log
socketpath = $${directory:run}/monitor.app.sock


[monitor_app_promise]
<= macro.promise
promise = check_socket_listening
config-pathname = $${monitor.app:socketpath}


[certificate]
recipe = plone.recipe.command
stop-on-error  = true
location = $${directory:ssl}/cert-and-key.pem
command =
  test -e $${:location} || \
    ${openssl:location}/bin/openssl req \
    -newkey rsa -batch -new -sha256 -x509 -days 3650 -nodes \
    -keyout $${:location} -out $${:location}
update-command = $${:command}


[haproxy.cfg]
recipe = slapos.recipe.template:jinja2
url = ${stack-haproxy-default-backend-config:target}
output = $${directory:etc}/$${:_buildout_section_name_}
context =
  key content :content
  key pidfile :pidfile
  key accepted :accepted-ipv6
pidfile = $${directory:run}/haproxy.pid
content =
  listen slapproxy
    log global
    bind $${:ipv6}:$${:slapproxy-port} ssl crt $${certificate:location}
    mode http
    option httplog
    http-request set-header X-Forwarded-Proto https
    server slapproxy $${slapproxy:ipv4}:$${slapproxy:port}
    tcp-request connection reject if !{ src $${:accepted-ipv6} }
{%- if software_type == 'henri' %}
  backend henri-backend
    server henri $${henri:ipv4}:$${henri:port}
  listen henri
    log global
    bind $${:ipv6}:$${:henri-port} ssl crt $${certificate:location}
    mode http
    option httplog
    http-request set-header X-Forwarded-Proto https
    # The henri GUI (served under /henri) calls the slapproxy JSON-RPC API
    # with paths relative to its own origin, one level up. Both live behind
    # this single listen so that still resolves to slapproxy.
    acl is-henri path_beg /henri
    use_backend henri-backend if is-henri
    server slapproxy $${slapproxy:ipv4}:$${slapproxy:port}
    tcp-request connection reject if !{ src $${:accepted-ipv6} }
{%- endif %}
  listen monitor
    log global
    bind $${:ipv6}:$${:monitor.app-port} ssl crt $${certificate:location}
    mode http
    option httplog
    server slapproxy unix@$${monitor.app:socketpath}
    tcp-request connection reject if !{ src $${:accepted-ipv6} }
accepted-ipv6 = {{ slapparameter_dict['accepted-client-ipv6'] }}
ipv6 = {{ public_ipv6 }}
slapproxy-port = 4000
{%- if software_type == 'henri' %}
henri-port = 4002
{%- endif %}
monitor.app-port = 4001


[haproxy]
recipe = slapos.cookbook:wrapper
wrapper-path = $${directory:service}/$${:_buildout_section_name_}
socket-path =  $${directory:run}/haproxy.sock
command-line =
  ${haproxy:location}/sbin/haproxy
    -W
    -S $${:socket-path},level,operator
    -f $${haproxy.cfg:output}
hash-files = $${haproxy.cfg:output}
ipv6 = $${haproxy.cfg:ipv6}
slapproxy-url = https://[$${:ipv6}]:$${haproxy.cfg:slapproxy-port}
{%- if software_type == 'henri' %}
henri-url = https://[$${:ipv6}]:$${haproxy.cfg:henri-port}/henri/
{%- endif %}
monitor.app-url = https://[$${:ipv6}]:$${haproxy.cfg:monitor.app-port}


[haproxy_promise]
<= macro.promise
promise = check_socket_listening
config-pathname = $${haproxy:socket-path}
