{%- set part_list = [] %}
{%- set slave_information_dict = {} %}
{%- set shared_information_dict = {} %}
{%- set frontend_node_information_dict = {} %}
{%- for frontend_key, frontend_value in frontend_information.items() %}
{%-   set frontend_node = frontend_key.replace('-node-information-json', '') %}
{%-   do frontend_node_information_dict.__setitem__(frontend_node, json_module.loads(frontend_value) if frontend_value else {}) %}
{%- endfor %}

# regroup slave information from all frontends
{%- for frontend, slave_list_raw in slave_information.items() %}
{%-   if slave_list_raw %}
{%-     set slave_list = json_module.loads(slave_list_raw) %}
{%-   else %}
{%-    set slave_list = [] %}
{%-   endif %}
{%-   for slave_dict in slave_list %}
{%-     set slave_reference = slave_dict.pop('slave-reference') %}
{%-     set log_access_url = slave_dict.pop('log-access', '') %}
{%-     set current_slave_dict = slave_information_dict.get(slave_reference, {}) %}
{%-     do current_slave_dict.update(slave_dict) %}
{%-     do slave_information_dict.__setitem__(slave_reference, current_slave_dict) %}
{%-     set current_shared_dict = shared_information_dict.setdefault(slave_reference, {'log-access-url': [], 'replication_number': 0}) %}
{%-     do current_shared_dict['log-access-url'].append(frontend + ': ' + log_access_url) %}
{%-     do current_shared_dict.__setitem__('replication_number', current_shared_dict['replication_number'] + 1) %}
{%-   endfor %}
{%- endfor %}

{%- for slave_reference, rejected_info_list in rejected_slave_information['rejected-slave-dict'].items() %}
{%-   if slave_reference not in slave_information_dict %}
{%-     do slave_information_dict.__setitem__(slave_reference, {}) %}
{%-   endif %}
{%-   do slave_information_dict[slave_reference].__setitem__('request-error-list', json_module.dumps(rejected_info_list)) %}
{%- endfor %}

{%- for slave_reference, warning_info_list in warning_slave_information['warning-slave-dict'].items() %}
{%-   if slave_reference not in slave_information_dict %}
{%-     do slave_information_dict.__setitem__(slave_reference, {}) %}
{%-   endif %}
{%-   do slave_information_dict[slave_reference].__setitem__('warning-list', json_module.dumps(warning_info_list)) %}
{%- endfor %}

{%- for slave_reference, epm_dict in json_module.loads(shared_error_page_information).items() %}
{%-   if slave_reference not in rejected_slave_information['rejected-slave-dict'] %}
{%-     if slave_reference not in slave_information_dict %}
{%-       do slave_information_dict.__setitem__(slave_reference, {}) %}
{%-     endif %}
{%-     if error_page_manager_frontend_base_url %}
{%-       set upload_path = '/' + epm_dict['upload-url'].split('/', 3)[3] %}
{%-       do slave_information_dict[slave_reference].__setitem__('error-page-upload-url', error_page_manager_frontend_base_url + upload_path) %}
{%-     else %}
{%-       do slave_information_dict[slave_reference].__setitem__('error-page-upload-url', epm_dict['upload-url']) %}
{%-     endif %}
{#      Note: auth token file path is not published to the slave directly; slaves get the URL only and obtain the token via the upload-auth-file key which the master reads at publish time #}
{%-   endif %}
{%- endfor %}

{%- for slave_reference, kedifa_dict in json_module.loads(slave_kedifa_information).items() %}
{%-   if slave_reference not in rejected_slave_information['rejected-slave-dict'] %}
{%-     if slave_reference not in slave_information_dict %}
{%-       do slave_information_dict.__setitem__(slave_reference, {}) %}
{%-     endif %}
{%-     do slave_information_dict[slave_reference].__setitem__('key-generate-auth-url', kedifa_dict['key-generate-auth-url']) %}
{%-     do slave_information_dict[slave_reference].__setitem__('key-upload-url', kedifa_dict['key-upload-url']) %}
{%-     do slave_information_dict[slave_reference].__setitem__('kedifa-caucase-url', kedifa_dict['kedifa-caucase-url']) %}
{%-   endif %}
{%- endfor %}

# Publish information for each slave
{%- set shared_information_file_dict = {} %}
{%- set shared_information_htpasswd_list = [] %}
{%- set active_slave_instance_list = json_module.loads(active_slave_instance_dict['active-slave-instance-list']) %}
{%- for slave_reference, slave_information in slave_information_dict.items() %}
{#   Filter out destroyed, so not existing anymore, slaves #}
{#   Note: This functionality is not yet covered by tests, please modify with care #}
{%-   if slave_reference in active_slave_instance_list %}
{%-     set publish_section_title = 'publish-%s' % slave_reference %}
{%-     do part_list.append(publish_section_title) %}
{%-     set shared_information_password_section = 'shared-information-password-%s' % slave_reference %}
{%-     set shared_information_password = '${%s:passwd}' % shared_information_password_section %}
{%-     set current_shared_dict = shared_information_dict.get(slave_reference, {'log-access-url': [], 'replication_number': 0}) %}
{%-     do current_shared_dict['log-access-url'].sort() %}
{%-     do shared_information_file_dict.__setitem__(slave_reference, current_shared_dict) %}
{%-     do shared_information_htpasswd_list.append('%s ${%s:passwd-apr-md5-crypt}' % (slave_reference, shared_information_password_section)) %}
{%-     set furled = furl_module.furl(shared_information_base_url) %}
{%-     do furled.set(username=slave_reference, password=shared_information_password) %}
{%-     do furled.path.add(slave_reference + '.json') %}
[{{ shared_information_password_section }}]
recipe = slapos.cookbook:generate.password
storage-path = {{ shared_information_password_directory }}/{{ slave_reference }}.passwd
bytes = 8

[{{ publish_section_title }}]
recipe = slapos.cookbook:publish_failsafe
-error-status-file = {{ publish_failsafe_error }}/{{ slave_reference }}-error.status
-slave-reference = {{ slave_reference }}
{#- unquote keeps the buildout reference to the password #}
shared-information-url = {{ urllib_module.parse.unquote(furled.tostr()) }}
{%-     for key, value in slave_information.items() %}
{{ key }} = {{ dumps(value) }}
{%-     endfor %}
{%-   endif %}
{%- endfor %}
{% do part_list.append('shared-information-file') %}
[shared-information-file]
recipe = slapos.recipe.build
directory = {{ shared_information_directory }}
htpasswd-directory = {{ shared_information_htpasswd_directory }}
{#- sort_keys are important in order to avoid shuffling parameters on each run #}
frontend-node-information = {{ dumps(json_module.dumps(frontend_node_information_dict, sort_keys=True)) }}
information = {{ dumps(json_module.dumps(shared_information_file_dict, sort_keys=True)) }}
htpasswd =
{%- for line in shared_information_htpasswd_list | sort %}
  {{ line }}
{%- endfor %}
init =
  import hashlib, json, os, shutil
  directory = options['directory']
  htpasswd_directory = options['htpasswd-directory']
  digest = hashlib.sha256((
    options['frontend-node-information'] + options['information']
    + options['htpasswd']).encode()
  ).hexdigest()
  digest_file = os.path.join(directory, '.digest')
  try:
    with open(digest_file) as fh:
      up_to_date = fh.read() == digest
  except IOError:
    up_to_date = False
  def write(filename, content):
    with open(filename + '.tmp', 'w') as fh:
      fh.write(content)
    os.rename(filename + '.tmp', filename)
  def clean(directory, keep_set):
    for name in os.listdir(directory):
      if name not in keep_set and not name.startswith('.'):
        path = os.path.join(directory, name)
        if os.path.isdir(path):
          shutil.rmtree(path)
        else:
          os.unlink(path)
  if not up_to_date:
    frontend_node_information = json.loads(options['frontend-node-information'])
    information = json.loads(options['information'])
    htpasswd = dict(
      line.split(' ', 1) for line in options['htpasswd'].splitlines() if line)
    for reference, value in information.items():
      value['frontend-node-information'] = frontend_node_information
      write(
        os.path.join(htpasswd_directory, reference + '.htpasswd'),
        '%s:%s\n' % (reference, htpasswd[reference]))
      write(
        os.path.join(directory, reference + '.json'),
        json.dumps(value, indent=2, sort_keys=True))
    clean(directory, {q + '.json' for q in information})
    clean(htpasswd_directory, {q + '.htpasswd' for q in information})
    with open(digest_file, 'w') as fh:
      fh.write(digest)

[buildout]
extends = {{ profile_common }}
parts =
{% for part in part_list %}
{{- '  %s' % part }}
{% endfor %}
