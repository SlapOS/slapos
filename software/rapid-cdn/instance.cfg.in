[buildout]
extends = {{ software_parameter_dict['profile_common'] }}

parts =
  software-py
  switch-softwaretype

[software-py]
recipe = software

[jinja2-template-base]
recipe = slapos.recipe.template:jinja2
output = ${buildout:directory}/${:filename}
extensions = jinja2.ext.do
extra-context =
context =
    import json_module json
    key slapparameter_dict slap-configuration:configuration
    section instance_parameter_dict slap-configuration
    section software_parameter_dict software-parameter-section
    ${:extra-context}
caucase-jinja2-library = {{ software_parameter_dict['caucase_jinja2_library'] }}
import-list =
  file caucase :caucase-jinja2-library

[switch-softwaretype]
recipe = slapos.cookbook:switch-softwaretype
default = dynamic-profile-master:output
custom-personal = dynamic-profile-master:output
single-default = dynamic-profile-frontend:output
single-custom-personal = dynamic-profile-frontend:output
single-custom-personal-detach = dynamic-profile-frontend-detach:output
replicate = dynamic-profile-master:output
kedifa = dynamic-profile-kedifa:output
error-page-manager = dynamic-profile-error-page-manager:output

[software-parameter-section]
{% for key,value in software_parameter_dict.items() %}
{{ key }} = {{ dumps(value) }}
{% endfor -%}

[dynamic-profile-frontend]
< = jinja2-template-base
url = {{ software_parameter_dict['profile_frontend'] }}
filename = instance-frontend.cfg
depends = ${detach-snapshot-writer:recipe}
extra-context =
  import furl_module furl
  raw software_type single-custom-personal

[detach-snapshot-writer]
{#- Not a rendered template. Buildout deletes the output of a template part
    when the part goes away. This part goes away when the node detaches, and
    that is the run which must read the snapshot. This recipe tracks no path.
    Only 'update' is set, so the recipe runs on each pass. #}
recipe = slapos.recipe.build
{#- Not a reference to [detach-snapshot]: a reference makes that section a
    dependency, and that section reads the snapshot. #}
path = ${buildout:directory}/.slapos-detach-snapshot.json
update =
  import json, time
  slap_configuration = self.buildout['slap-configuration']
  with open(options['path'], 'w') as snapshot_file:
    json.dump({
      'timestamp': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
      'configuration': slap_configuration['configuration'],
      'slave-instance-list': slap_configuration.get('slave-instance-list', []),
    }, snapshot_file, indent=2, sort_keys=True)

[dynamic-profile-frontend-detach]
{#- No detach-snapshot-writer dependency: the whole point is to render from
    the snapshot instead of from what SlapOS Master sends now, so a detached
    node must not refresh it. #}
< = jinja2-template-base
url = {{ software_parameter_dict['profile_frontend'] }}
filename = instance-frontend.cfg
extra-context =
  import furl_module furl
  raw software_type single-custom-personal-detach
  key detach_snapshot detach-snapshot:snapshot

[detach-snapshot]
recipe = slapos.recipe.build
path = ${buildout:directory}/.slapos-detach-snapshot.json
init =
  import json
  from zc.buildout import UserError
  try:
    snapshot_file = open(options['path'])
  except IOError:
    raise UserError(
      "no detach snapshot: re-attach the node, let one instantiation"
      " finish, then detach again")
  with snapshot_file:
    options['snapshot'] = json.load(snapshot_file)

[dynamic-profile-master]
< = jinja2-template-base
depends = ${software-py:recipe}
url = {{ software_parameter_dict['profile_master'] }}
filename = instance-master.cfg
extra-context =
    import subprocess_module subprocess
    import functools_module functools
    import operator_module operator
    import validators validators
    import software software
# Must match the key id in [switch-softwaretype] which uses this section.
# Keep RootSoftwareInstance for backward compatibility until all instances have
# changed their software_type to default
    raw software_type RootSoftwareInstance-default-custom-personal-replicate

[dynamic-profile-kedifa]
< = jinja2-template-base
url = {{ software_parameter_dict['profile_kedifa'] }}
filename = instance-kedifa.cfg
extra-context =
  raw software_type kedifa

[dynamic-profile-error-page-manager]
< = jinja2-template-base
url = {{ software_parameter_dict['profile_error_page_manager'] }}
filename = instance-error-page-manager.cfg
extra-context =
  raw software_type error-page-manager

[slap-configuration]
# Fetches parameters defined in SlapOS Master for this instance.
# Always the same.
recipe = slapos.cookbook:slapconfiguration.jsonschema.localdb
jsonschema = {{ software_parameter_dict['software.cfg.json'] }}
depends =
  {{ software_parameter_dict['instance-input-schema.json'] }}
  {{ software_parameter_dict['instance-frontend-input-schema.json'] }}
  {{ software_parameter_dict['instance-slave-input-schema.json'] }}
  {{ software_parameter_dict['instance-kedifa-input-schema.json'] }}
  {{ software_parameter_dict['instance-error-page-manager-input-schema.json'] }}
set-default = main
validate-parameters = main
report-error = main
instance-db-path = ${buildout:directory}/slapconfiguration-shared-instance.sqlite
computer = ${slap-connection:computer-id}
partition = ${slap-connection:partition-id}
url = ${slap-connection:server-url}
key = ${slap-connection:key-file}
cert = ${slap-connection:cert-file}
